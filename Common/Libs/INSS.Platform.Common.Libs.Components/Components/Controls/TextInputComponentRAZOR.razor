@page "/textinput2"
@using INSS.Platform.Common.Libs.Components.Components.Controls
@using INSS.Platform.Common.Libs.Components.Models


<h3>Our 'TextInput' Component (using Render Tree)</h3>

<EditForm Formname="TestForm" Model="PostalAddress" OnSubmit="Submit">

    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="govuk-form-group">
        <h1 class="govuk-label-wrapper">
            <label class="govuk-label govuk-label--l" for="event-name">
                What is the name of the event?
            </label>
        </h1>
        <InputText @bind-Value="PostalAddress!.Line1" class="govuk-input" />
    </div>

    <ButtonComponent ButtonText="Submit" />
 
</EditForm>


<h3>GDS Html version></h3>

<div class="govuk-form-group">
    <h1 class="govuk-label-wrapper">
        <label class="govuk-label govuk-label--l" for="event-name">
            What is the name of the event?
        </label>
    </h1>
    <input class="govuk-input" id="event-name" name="eventName" type="text">
</div>
<ButtonComponent ButtonText="Submit" />


@code {
    [SupplyParameterFromForm] public AddressModel? PostalAddress { get; set; }

    public string? Result { get; set; }

    protected override void OnInitialized()
    {
        PostalAddress ??= new AddressModel();

        base.OnInitialized();
    }

    private void Submit()
    {
        Result = $"line1: {PostalAddress!.Line1}, line2: {PostalAddress.Line2}";
    }
    
    // public class AddressModel
    // {
    //     public string Line1 { get; set; } = string.Empty;
    //     public string Line2 { get; set; } = string.Empty;
    // }
}
